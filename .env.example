# ฐานข้อมูล: SQLite (ค่าเริ่มต้น) หรือ PostgreSQL
DATABASE_URL=sqlite:///./data/expiry_ocr.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/expiry_ocr

# OCR engine: rapidocr (AI OCR จริง, ค่าเริ่มต้น) | trocr | vlm | auto (ภาพสังเคราะห์=mock, ภาพจริง=rapidocr) | mock
OCR_ENGINE=rapidocr
TROCR_MODEL=microsoft/trocr-base-printed
# VLM ผ่าน OpenAI-compatible endpoint (เช่น vLLM เสิร์ฟ Qwen2.5-VL)
VLM_ENDPOINT=http://localhost:8001/v1/chat/completions
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLM_API_KEY=

# เกณฑ์ routing
CONFIDENCE_THRESHOLD=0.90
MAX_SHELF_LIFE_YEARS=10
# จำนวนรอบอ่าน (multi-pass ensemble) 1 = ปิด, 3 = แนะนำเพื่อความแม่นยำสูง
ENSEMBLE_PASSES=3

STORAGE_DIR=./data/storage
API_URL=http://localhost:8000
# ไฟล์ calibration คะแนนความมั่นใจของแต่ละ OCR engine (สร้างด้วย evaluation.evaluate --fit-calibration)
CALIBRATION_FILE=./models/calibration.json
